---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarraFilter from '../../components/interactive/BarraFilter';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('equipo');
const productsData = allProducts.map((p) => p.data);
---

<BaseLayout
  title="La Barra de Equipo — Tazamo"
  description="Catálogo editorial de molinillos, básculas, cafeteras y hervidores para preparar café en casa sin compras innecesarias ni valoraciones falsas."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'La Barra', url: '/equipo' },
  ]}
>
  <div class="w-full bg-cereza-oscura text-porcelana py-14 sm:py-20 border-b border-porcelana/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-10 pb-4 border-b border-porcelana/15">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-porcelana mb-3">
          La Barra de Equipo
        </h1>
        <p class="text-sm sm:text-base text-humo-claro leading-relaxed font-sans">
          Cada herramienta ha sido elegida por su repetibilidad técnica y durabilidad. Sin precios fijos desactualizados ni estrellas infladas: consulta los contras reales antes de decidir.
        </p>
      </div>

      <BarraFilter client:idle initialProducts={productsData} isShelf={false} showFilters={true} />
    </div>
  </div>
</BaseLayout>
