---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuias = await getCollection('guias');
const sortedGuias = allGuias.sort(
  (a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime()
);
---

<BaseLayout
  title="Guías de café — Tazamo"
  description="Artículos técnicos, resolución de problemas de extracción, comparativas de equipo y tutoriales paso a paso para amantes del café en casa."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Guías', url: '/guias' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="max-w-2xl mb-12">
      <h1 class="font-display text-4xl sm:text-5xl text-espresso mb-3">
        Guías y tutoriales de café
      </h1>
      <p class="text-sm sm:text-base text-humo leading-relaxed font-sans">
        Explicaciones directas y sin relleno para calibrar tus moliendas, evitar sabores agrios o quemados y sacar el máximo partido a cada grano.
      </p>
    </div>

    {/* Cuadrícula de artículos sin sombras genéricas */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedGuias.map((g) => (
        <article class="p-6 rounded-md bg-[#FAFBF9] border border-espresso/15 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3 text-xs text-humo font-sans">
              <span class="font-semibold text-cereza-oscura uppercase">
                {g.data.metodo}
              </span>
              <span>{g.data.tiempoLectura} de lectura</span>
            </div>

            <h2 class="font-display text-xl text-espresso group-hover:text-cereza-oscura transition-colors mb-2 leading-snug">
              <a href={`/guias/${g.id}`}>
                {g.data.titulo}
              </a>
            </h2>

            <p class="text-xs text-humo leading-relaxed line-clamp-3 mb-6 font-sans">
              {g.data.descripcion}
            </p>
          </div>

          <div class="pt-4 border-t border-espresso/10 flex items-center justify-between text-xs font-sans">
            <span class="text-humo">{g.data.autor}</span>
            <a
              href={`/guias/${g.id}`}
              class="font-semibold text-cereza-oscura group-hover:underline"
            >
              Leer guía
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
