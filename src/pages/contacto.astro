---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto — Tazamo"
  description="Ponte en contacto con el equipo de Tazamo para dudas sobre extracción, sugerencias o correcciones editoriales."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Contacto', url: '/contacto' },
  ]}
>
  <div class="max-w-xl mx-auto px-4 sm:px-6 py-12 sm:py-16 text-espresso">
    <span class="text-xs uppercase font-bold tracking-wider text-humo font-mono">
      Hablemos de café
    </span>
    <h1 class="font-display text-4xl sm:text-5xl text-espresso mt-1 mb-4">
      Contacto
    </h1>
    <p class="text-sm text-humo leading-relaxed mb-8">
      ¿Tienes alguna duda sobre una receta, sugerencia de método o has detectado una errata técnica en alguna guía? Escríbenos directamente:
    </p>

    <form class="space-y-4 bg-white p-6 sm:p-8 rounded-lg border border-espresso/10 shadow-sm" onsubmit="event.preventDefault(); alert('¡Mensaje enviado con éxito!');">
      <div>
        <label for="nombre" class="block text-xs font-semibold text-espresso mb-1">
          Tu nombre
        </label>
        <input
          id="nombre"
          type="text"
          required
          placeholder="Ej: Clara o Daniel"
          class="w-full px-4 py-2.5 rounded-md border border-espresso/20 text-sm focus:outline-none focus:border-cereza-oscura"
        />
      </div>

      <div>
        <label for="email" class="block text-xs font-semibold text-espresso mb-1">
          Correo electrónico
        </label>
        <input
          id="email"
          type="email"
          required
          placeholder="tu.correo@ejemplo.com"
          class="w-full px-4 py-2.5 rounded-md border border-espresso/20 text-sm focus:outline-none focus:border-cereza-oscura"
        />
      </div>

      <div>
        <label for="mensaje" class="block text-xs font-semibold text-espresso mb-1">
          Mensaje o consulta
        </label>
        <textarea
          id="mensaje"
          rows="4"
          required
          placeholder="Cuéntanos en qué podemos ayudarte..."
          class="w-full px-4 py-2.5 rounded-md border border-espresso/20 text-sm focus:outline-none focus:border-cereza-oscura"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3 rounded-pill bg-cereza-oscura text-porcelana font-semibold text-sm hover:bg-cereza-profunda transition-all min-h-[44px]"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</BaseLayout>
