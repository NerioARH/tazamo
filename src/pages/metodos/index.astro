---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LISTA_METODOS } from '../../config';

const getTuesteBadge = (nivel: string) => {
  switch (nivel) {
    case 'crudo': return 'bg-tueste-crudo text-espresso';
    case 'claro': return 'bg-tueste-claro text-espresso';
    case 'medio': return 'bg-tueste-medio text-espresso';
    case 'oscuro': return 'bg-tueste-oscuro text-porcelana';
    case 'espresso': return 'bg-tueste-espresso text-porcelana';
    default: return 'bg-tueste-claro text-espresso';
  }
};
---

<BaseLayout
  title="Métodos de café — Tazamo"
  description="Domina los 6 métodos fundamentales de preparación de café en casa: espresso, moka, prensa francesa, V60, AeroPress y cold brew con parámetros precisos."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Métodos', url: '/metodos' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <div class="max-w-2xl mb-12">
      <h1 class="font-display text-4xl sm:text-5xl text-espresso mb-3">
        Los 6 métodos de café
      </h1>
      <p class="text-sm sm:text-base text-humo leading-relaxed font-sans">
        Cada sistema de preparación resalta virtudes químicas distintas del grano. Conoce los ratios de referencia, las curvas de molienda y el equipo adecuado para cada uno.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {LISTA_METODOS.map((m) => (
        <article class="p-6 rounded-md bg-[#FAFBF9] border border-espresso/15 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4 font-sans text-xs">
              <span class={`px-2.5 py-0.5 rounded text-[11px] font-semibold ${getTuesteBadge(m.nivelTueste)}`}>
                Tueste {m.tuesteLabel}
              </span>
              <span class="text-humo">
                {m.temperatura}
              </span>
            </div>

            <h2 class="font-display text-2xl text-espresso group-hover:text-cereza-oscura transition-colors mb-2">
              <a href={`/metodos/${m.id}`}>
                {m.nombre}
              </a>
            </h2>

            <p class="text-xs text-humo leading-relaxed mb-6 font-sans">
              {m.descripcionCorta}
            </p>

            <div class="p-4 rounded bg-porcelana text-xs space-y-1.5 font-sans mb-6 border border-espresso/10">
              <div class="flex justify-between">
                <span class="text-humo">Ratio:</span>
                <strong class="text-espresso tabular-nums">{m.ratio}</strong>
              </div>
              <div class="flex justify-between">
                <span class="text-humo">Molienda:</span>
                <strong class="text-espresso">{m.molienda}</strong>
              </div>
              <div class="flex justify-between">
                <span class="text-humo">Tiempo:</span>
                <strong class="text-espresso tabular-nums">{m.tiempo}</strong>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-espresso/10 flex items-center justify-between text-xs font-sans">
            <a
              href={`/metodos/${m.id}`}
              class="font-semibold text-cereza-oscura group-hover:underline"
            >
              Guía técnica
            </a>
            <a
              href={`/equipo?metodo=${m.id}`}
              class="text-humo hover:text-espresso"
            >
              Equipo
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
