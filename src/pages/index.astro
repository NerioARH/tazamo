---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtractionDial from '../components/interactive/ExtractionDial';
import BarraFilter from '../components/interactive/BarraFilter';
import QuickTipBar from '../components/interactive/QuickTipBar';
import NewsletterForm from '../components/interactive/NewsletterForm';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('equipo');
const productsData = allProducts.map((p) => p.data);

const allGuias = await getCollection('guias');
const sortedGuias = allGuias.sort(
  (a, b) => new Date(b.data.fechaPublicacion).getTime() - new Date(a.data.fechaPublicacion).getTime()
);

const featuredGuia = sortedGuias[0];
const secondaryGuias = sortedGuias.slice(1, 3);
---

<BaseLayout
  title="Tazamo — Tu barra de café en casa"
  description="Guías, recetas, herramientas interactivas y equipo seleccionado para preparar en casa el café que pagas en la mejor cafetería de especialidad."
>
  {/* SECCIÓN 1: HERO (Banda cereza-oscura con Dial de extracción y Taza cenital) */}
  <section class="w-full bg-cereza-oscura py-12 sm:py-16 lg:py-20 border-b border-porcelana/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <ExtractionDial client:load initialMethodId="v60" />
    </div>
  </section>

  {/* SECCIÓN 2: TIRA DE TIP DEL DÍA (Problema → Solución) */}
  <QuickTipBar client:idle />

  {/* SECCIÓN 3: PORCELANA — Empieza por aquí (Composición asimétrica editorial sin tarjetas idénticas ni sombras) */}
  <section class="w-full py-16 sm:py-24 bg-porcelana">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-10 pb-4 border-b border-espresso/15">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-espresso tracking-tight">
          Empieza por aquí
        </h2>
        <a href="/guias" class="text-xs font-semibold text-cereza-oscura hover:underline">
          Ver todas las guías
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        {/* Guía Destacada de Fondo (8 columnas) — Formato editorial sin caja flotante */}
        {featuredGuia && (
          <article class="lg:col-span-8 flex flex-col justify-between group">
            <div>
              <div class="flex items-center gap-3 mb-4 text-xs text-humo">
                <span class="font-semibold text-cereza-oscura uppercase tracking-wide">
                  {featuredGuia.data.metodo}
                </span>
                <span>·</span>
                <span>{featuredGuia.data.tiempoLectura} de lectura</span>
              </div>

              <h3 class="font-display text-3xl sm:text-4xl text-espresso group-hover:text-cereza-oscura transition-colors mb-4 leading-tight">
                <a href={`/guias/${featuredGuia.id}`}>
                  {featuredGuia.data.titulo}
                </a>
              </h3>

              <p class="text-base text-humo leading-relaxed mb-6 max-w-2xl font-sans">
                {featuredGuia.data.descripcion}
              </p>

              {/* Respuesta rápida: Caja tonal con borde fino sobre porcelana */}
              <div class="p-5 rounded-md bg-[#FAFBF9] border border-espresso/15 text-xs text-espresso leading-relaxed max-w-2xl">
                <strong class="font-semibold block mb-1 text-cereza-oscura">Respuesta rápida:</strong>
                {featuredGuia.data.respuestaRapida}
              </div>
            </div>

            <div class="pt-6 mt-8 border-t border-espresso/15 flex items-center justify-between text-xs">
              <span class="text-humo">Por {featuredGuia.data.autor}</span>
              <a
                href={`/guias/${featuredGuia.id}`}
                class="font-semibold text-cereza-oscura group-hover:underline"
              >
                Leer guía completa
              </a>
            </div>
          </article>
        )}

        {/* 2 Guías Satélite Desiguales (4 columnas) — Separadas por línea de imprenta */}
        <div class="lg:col-span-4 flex flex-col gap-8 lg:pl-6 lg:border-l lg:border-espresso/15">
          {secondaryGuias.map((g, idx) => (
            <article class="flex flex-col justify-between group pb-6 border-b border-espresso/10 last:border-b-0 last:pb-0">
              <div>
                <div class="flex items-center gap-2 mb-2 text-xs text-humo">
                  <span class="uppercase font-medium text-cereza-oscura">
                    {g.data.metodo}
                  </span>
                  <span>·</span>
                  <span>{g.data.tiempoLectura}</span>
                </div>
                <h4 class="font-display text-xl text-espresso group-hover:text-cereza-oscura transition-colors mb-2 leading-snug">
                  <a href={`/guias/${g.id}`}>
                    {g.data.titulo}
                  </a>
                </h4>
                <p class="text-xs text-humo line-clamp-3 leading-relaxed font-sans">
                  {g.data.descripcion}
                </p>
              </div>

              <div class="pt-4 mt-3">
                <a
                  href={`/guias/${g.id}`}
                  class="text-xs font-semibold text-cereza-oscura group-hover:underline"
                >
                  Ver artículo
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* SECCIÓN 4: CEREZA — La Barra (Estantería horizontal filtrable en cereza-oscura) */}
  <section class="w-full py-16 sm:py-24 bg-cereza-oscura text-porcelana border-y border-porcelana/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-10 pb-4 border-b border-porcelana/15">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl text-porcelana">
            La Barra de Equipo
          </h2>
          <p className="text-xs sm:text-sm text-humo-claro mt-1 font-sans">
            El equipo que de verdad necesitas para cada método, con sus contras reales y sin inventar valoraciones.
          </p>
        </div>
        <a
          href="/equipo"
          class="text-xs font-semibold text-crema hover:underline shrink-0"
        >
          Explorar catálogo completo
        </a>
      </div>

      <BarraFilter client:idle initialProducts={productsData} isShelf={true} showFilters={true} />
    </div>
  </section>

  {/* SECCIÓN 5: PORCELANA — Herramientas Interactivas (Quiz y Calculadora sin cajas genéricas) */}
  <section class="w-full py-16 sm:py-24 bg-porcelana">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl sm:text-4xl text-espresso mb-2">
          Calibra tu café a medida
        </h2>
        <p class="text-xs sm:text-sm text-humo font-sans">
          Resuelve dudas en segundos: descubre la cafetera para tu rutina o mide tus ratios y tiempos al gramo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch">
        <div class="p-6 sm:p-8 rounded-md bg-[#FAFBF9] border border-espresso/15 flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-semibold bg-crema text-espresso mb-4">
              Test interactivo
            </span>
            <h3 class="font-display text-2xl sm:text-3xl text-espresso mb-3">
              Tu cafetera en 4 preguntas
            </h3>
            <p class="text-sm text-humo leading-relaxed mb-6 font-sans">
              ¿No sabes si elegir V60, moka, AeroPress o prensa francesa? Responde 4 preguntas sobre tu consumo, tiempo matutino y presupuesto para recibir una recomendación con motivos claros.
            </p>
          </div>
          <a
            href="/herramientas#quiz"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-pill bg-cereza-oscura text-porcelana font-semibold text-xs hover:bg-cereza-profunda transition-all min-h-[44px]"
          >
            Hacer el quiz en 1 minuto
          </a>
        </div>

        <div class="p-6 sm:p-8 rounded-md bg-[#FAFBF9] border border-espresso/15 flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-semibold bg-cereza-oscura text-porcelana mb-4">
              Precisión de extracción
            </span>
            <h3 class="font-display text-2xl sm:text-3xl text-espresso mb-3">
              Calculadora de ratio y temporizador
            </h3>
            <p class="text-sm text-humo leading-relaxed mb-6 font-sans">
              Introduce cuántos gramos de café o mililitros de agua tienes y obtén al instante las proporciones exactas con cronómetro por fases (floración, vertido y vaciado).
            </p>
          </div>
          <a
            href="/herramientas#calculadora"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-pill border border-cereza-oscura text-cereza-oscura font-semibold text-xs hover:bg-cereza-oscura hover:text-porcelana transition-all min-h-[44px]"
          >
            Abrir calculadora de ratio
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* SECCIÓN 6: CEREZA PROFUNDA — Newsletter «La receta del domingo» */}
  <section class="w-full py-16 sm:py-20 bg-cereza-profunda text-porcelana border-t border-porcelana/15">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display text-3xl sm:text-4xl text-porcelana mb-3">
        La receta del domingo
      </h2>
      <p class="text-xs sm:text-sm text-humo-claro max-w-lg mx-auto mb-8 leading-relaxed font-sans">
        Cada domingo a primera hora compartimos un ajuste de molienda, una receta calibrada o un truco práctico para tu cocina. Cero spam publicitario y sin enlaces de afiliados en tu bandeja de entrada.
      </p>

      <NewsletterForm client:idle />
    </div>
  </section>
</BaseLayout>
