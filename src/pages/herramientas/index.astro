---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoffeeQuiz from '../../components/interactive/CoffeeQuiz';
import RatioCalculator from '../../components/interactive/RatioCalculator';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('equipo');
const productsData = allProducts.map((p) => p.data);
---

<BaseLayout
  title="Herramientas de barra — Tazamo"
  description="Quiz interactivo para encontrar tu cafetera ideal, calculadora de ratio de café y agua y temporizador de extracción por fases."
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Herramientas', url: '/herramientas' },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20 space-y-20">
    {/* Encabezado */}
    <div class="max-w-2xl">
      <h1 class="font-display text-4xl sm:text-5xl text-espresso mb-3">
        Herramientas de barra
      </h1>
      <p class="text-sm sm:text-base text-humo leading-relaxed font-sans">
        Elimina las dudas en tu cocina con utilidades diseñadas para aficionados y baristas en casa.
      </p>
    </div>

    {/* SECCIÓN QUIZ */}
    <section id="quiz" class="scroll-mt-24">
      <div class="mb-8 pb-4 border-b border-espresso/15">
        <h2 class="font-display text-3xl sm:text-4xl text-espresso mb-1">
          Tu cafetera en 4 preguntas
        </h2>
        <p class="text-xs sm:text-sm text-humo font-sans">
          Responde a cuatro hábitos de tu mañana para obtener una selección personalizada con alternativas y enlace directo.
        </p>
      </div>

      <CoffeeQuiz client:load products={productsData} />
    </section>

    {/* SECCIÓN CALCULADORA Y TIMER */}
    <section id="calculadora" class="scroll-mt-24 pt-8">
      <div class="mb-8 pb-4 border-b border-espresso/15">
        <h2 class="font-display text-3xl sm:text-4xl text-espresso mb-1">
          Calculadora de ratio y temporizador
        </h2>
        <p class="text-xs sm:text-sm text-humo font-sans">
          Ajusta tu receta para cualquier método y guía tus vertidos con el cronómetro de fases integrado.
        </p>
      </div>

      <RatioCalculator client:load />
    </section>
  </div>
</BaseLayout>
